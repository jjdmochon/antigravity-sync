# Plantilla de ~\.env (C:\Users\<usuario>\.env). Solo nombres: NUNCA pongas valores aqui.
# Copiala a ~\.env en cada equipo y rellena las claves. sync-pull avisa de las que falten.

# Motor Jev System-1 (jev-system-one, gatekeeper del pipeline documental).
# Panel de TypeSafe AI -> API keys.
TYPESAFE_API_KEY=

# AlphaGenome (skills alphagenome-*). Clave de Google Cloud con la API de AlphaGenome permitida.
ALPHAGENOME_API_KEY=

# Gemini API (gemini-api-dev, gemini-omni-flash-api, google-genai). Crear en https://aistudio.google.com/apikey.
# No definas tambien GOOGLE_API_KEY: google-genai la prefiere y avisa en cada arranque.
# Ojo: si reutilizas la clave de AlphaGenome, anade "Generative Language API" a sus APIs
# permitidas en Google Cloud; si no, Gemini responde 403 API_KEY_SERVICE_BLOCKED.
GEMINI_API_KEY=
